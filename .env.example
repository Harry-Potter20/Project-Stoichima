# ── Required ─────────────────────────────────────────────────────────────────
# football-data.org API key (free tier: 10 req/min)
# Sign up at https://www.football-data.org/
FOOTBALL_DATA_API_KEY=your_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Default: local SQLite file. For Postgres: postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./football.db

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
MODEL_VERSION=1.0.0

# Protect /admin/* endpoints — when set, requests must send this value in the
# X-Admin-Key header. Leave blank to keep them open (local dev only).
ADMIN_API_KEY=

# ── Odds API ─────────────────────────────────────────────────────────────────
# The Odds API (free tier: 500 req/month) — https://the-odds-api.com/
ODDS_API_KEY=

# ── API-Football ──────────────────────────────────────────────────────────────
# Injury / suspension data (free tier: 100 req/day) — https://www.api-football.com/
API_FOOTBALL_KEY=

# ── Telegram alerts ───────────────────────────────────────────────────────────
# Create a bot via @BotFather; get chat_id from @userinfobot. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_EDGE=8.0

# ── Webhook (Discord / Slack / n8n) ──────────────────────────────────────────
# POST payload sent when model edge >= WEBHOOK_MIN_EDGE. Leave blank to disable.
WEBHOOK_URL=
WEBHOOK_MIN_EDGE=8.0

# ── Daily email digest ────────────────────────────────────────────────────────
# SMTP credentials for the scheduled daily digest. Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_EMAIL_TO=

# ── Prediction tuning ─────────────────────────────────────────────────────────
# Share of 1X2 probability taken from the bookmaker closing line (0=pure model,
# 1=pure market). Default 0.7 anchors leagues to the well-calibrated market
# (the outcome model currently has negative skill — see validation/holdout.py).
# No-op where odds are absent (international/WC). Lower once the model is retrained.
MARKET_BLEND_WEIGHT=0.7
# Only call a Draw when its probability clears this floor and beats both sides.
DRAW_PICK_FLOOR=0.40

# ── Bankroll / risk controls ──────────────────────────────────────────────────
BANKROLL_SIZE=1000.0
MAX_DAILY_KELLY_PCT=15.0
DAILY_LOSS_LIMIT_PCT=10.0
CLV_ALERT_THRESHOLD=5.0

# ── MLflow experiment tracking ────────────────────────────────────────────────
# Local SQLite (default — no setup needed, run `mlflow ui` to view):
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# DagHub (remote — set when ready for collaboration/cloud):
# MLFLOW_TRACKING_URI=https://dagshub.com/<username>/Project_Stoichima_V1.mlflow
# MLFLOW_TRACKING_USERNAME=<dagshub_username>
# MLFLOW_TRACKING_PASSWORD=<dagshub_token>
